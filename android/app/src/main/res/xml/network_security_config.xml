<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks cleartext HTTP by default from API 28 onward.

  The reader deliberately serves its shell and book files over http://127.0.0.1 so the
  page runs in a "potentially trustworthy" origin, which is what makes crypto.subtle
  available for foliate's IDPF font deobfuscation. That is the ONLY cleartext this app
  needs, so it is scoped to loopback and everything else stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
